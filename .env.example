# ============================================================
# Quantstrike — single merged service (worker + gateway)
# Copy to `.env` for local dev; set the same keys in the Render dashboard.
# ============================================================

# ---- Supabase --------------------------------------------------------------
# IMPORTANT: one deploy = one Supabase project. The worker's reg_* tables and
# the gateway's users/messages/documents/practice_sessions tables must live in
# THIS project. If they are currently in two different projects, consolidate
# first (run migrations/000_full_setup.sql + sql/tier_migration.sql there).
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_KEY=<anon-key>                 # worker (app/db) read client
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>   # gateway backend writes
SUPABASE_BUCKET=GCEResources            # past-paper storage bucket (gateway)

# ---- LLM / audio -----------------------------------------------------------
OPENAI_API_KEY=<openai-key>             # worker RAG embeddings (text-embedding-3-large)
OPENROUTER_API_KEY=<openrouter-key>     # gateway chat/vision (Gemini via OpenRouter)
GROQ_API_KEY=<groq-key>                 # gateway Whisper transcription
GEMINI_MODEL=google/gemini-2.5-flash
WHISPER_MODEL=whisper-large-v3
OPENROUTER_REFERER=https://quantstrike.onrender.com
OPENROUTER_APP_TITLE=Quantstrike

# ---- Session / rate-limit state (gateway) ----------------------------------
REDIS_URL=redis://<host>:<port>

# ---- Internal self-calls ---------------------------------------------------
# The master controller calls this app's own /api/rag, /api/extract, etc.
# Leave BASE_URL unset in production — the code falls back to
# http://127.0.0.1:$PORT, which Render sets automatically.
# BASE_URL=http://127.0.0.1:8000

# ---- WhatsApp (worker; optional) -------------------------------------------
WHATSAPP_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=

# ---- Carati (app/edu/config.py). All optional; defaults shown ---------------
EDU_SECRET_KEY=change-me-long-random          # signs login tokens and OTP hashes — MUST be set in production
# CARATI_FREE_QUESTIONS=15  CARATI_FREE_PAPERS=2  CARATI_TRACK_QUESTIONS=30  CARATI_TRACK_PAPERS=4
# CARATI_FREE_FOLLOW_UPS=3
# CARATI_LAUNCH_SUBJECTS=physics,chemistry,math,biology,economics
# Prices (FCFA) are placeholders until parent interviews fix them:
# CARATI_PRICE_Q10=200 CARATI_PRICE_Q25=450 CARATI_PRICE_Q50=800 CARATI_PRICE_P5=250 CARATI_PRICE_P15=600 CARATI_PRICE_SEASON=5000
# CARATI_OTP_REQUIRED=false   # turn on once an SMS provider is added in app/edu/otp.py
# CARATI_SMS_PROVIDER=log
# CARATI_PAYMENT_PROVIDER=manual   # admin confirms payments until an aggregator (Campay/CinetPay) is wired in app/edu/payments.py
# CARATI_EXPLAIN_MODEL=google/gemini-2.5-flash  CARATI_MARKING_MODEL=google/gemini-2.5-flash-lite  CARATI_TAGGING_MODEL=google/gemini-2.5-flash-lite
# CARATI_ANSWER_MAX_TOKENS=900
# CARATI_STRICT_GROUNDING=false   # true = refuse syllabus questions the library has no material for (LLM-1)
# CARATI_TEACHER_MARKS_PER_WEEK=2
# INTERNAL_API_TOKEN=             # lets /api/rag be called from outside localhost
