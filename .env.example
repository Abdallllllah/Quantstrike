# ==========================================
# EXISTING CONFIGURATION
# ==========================================

# Groq API Key (for LLM)
GROQ_API_KEY=your_groq_api_key_here

# Google API Key (optional, for Google Generative AI)
GOOGLE_API_KEY=your_google_api_key_here

# ==========================================
# NEW: SUPABASE CONFIGURATION
# ==========================================

# Supabase project URL (from Settings > API)
SUPABASE_URL=https://your-project.supabase.co

# Supabase service key (from Settings > API > service_role key)
# WARNING: This key has admin privileges. Keep it secret!
SUPABASE_KEY=your_supabase_service_key_here

# ==========================================
# NEW: WHATSAPP CONFIGURATION
# ==========================================

# WhatsApp Cloud API access token (from Meta Developer Console)
WHATSAPP_TOKEN=your_whatsapp_access_token_here

# WhatsApp Phone Number ID (from Meta Developer Console)
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here

# Webhook verification token (you create this, must match Meta config)
WHATSAPP_VERIFY_TOKEN=your_verify_token_here

# Optional: App secret for webhook signature validation
# WHATSAPP_APP_SECRET=your_app_secret_here
